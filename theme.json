{
  "name": "Emerald",
  "short": "emerald",
  "description": "翡翠色状态页，地球视图、卡片与列表双模式",
  "version": "1.0.2",
  "author": "Tokinx, lcyan",
  "url": "https://github.com/lcyan/monitor-theme-emerald",
  "config": [
    { "type": "title", "label": "基础设置" },
    { "key": "defaultViewMode", "type": "select", "label": "默认视图模式", "default": "card", "options": [{ "value": "card", "label": "卡片" }, { "value": "list", "label": "列表" }], "help": "节点列表的默认显示模式，访客切换后以访客的选择为准" },
    { "key": "listPingEnabled", "type": "boolean", "label": "列表显示延迟", "default": true, "help": "在节点卡片与列表中显示近一小时的延迟与丢包。每个节点会单独查询一次历史，节点很多时可关闭以减轻 hub 负担" },
    { "key": "pingNetworkOrder", "type": "string", "label": "延迟探测排序", "default": "", "help": "列表中显示的探测名称及顺序，英文逗号分隔，最多显示 3 条。示例：上海联通,上海电信,上海移动；留空按后台顺序取前 3 条" },
    { "key": "offlineNodesLast", "type": "boolean", "label": "离线节点后置", "default": false, "help": "开启后离线节点默认显示到所有节点最后" },
    { "type": "title", "label": "公告设置" },
    { "key": "alertEnabled", "type": "boolean", "label": "启用公告", "default": false, "help": "在首页显示自定义公告" },
    { "key": "alertTitle", "type": "string", "label": "公告标题", "default": "" },
    { "key": "alertContent", "type": "text", "label": "公告内容", "default": "", "help": "支持简单 Markdown 格式" },
    { "type": "title", "label": "页面设置" },
    { "key": "earthViewMode", "type": "select", "label": "头部展示模式", "default": "earth", "options": [{ "value": "earth", "label": "自转地球" }, { "value": "earth-stop", "label": "静止地球" }, { "value": "maps", "label": "点状地图" }, { "value": "cards", "label": "仅头部卡片" }, { "value": "hide", "label": "隐藏头部" }] },
    { "key": "visitorInfoCardEnabled", "type": "boolean", "label": "访客信息卡片", "default": true, "help": "显示访客来源、设备和浏览器信息。访客 IP 归属由第三方接口查询" },
    { "key": "hideAdminEntryWhenLoggedOut", "type": "boolean", "label": "隐藏后台入口", "default": false, "help": "未登录时隐藏顶部后台管理入口" },
    { "key": "disablePageAnimation", "type": "boolean", "label": "减弱过渡动画", "default": false, "help": "减少页面过渡动画效果，提升访问速度和响应性" },
    { "key": "chartTimeRanges", "type": "string", "label": "图表时间范围", "default": "1,6,24,168,720,2160", "help": "负载与延迟图的时间档位，逗号分隔的小时数：≤24 显示为小时，24 的倍数显示为天；超出 168 的档位仅登录可见。按后台「历史保留天数」取舍，如只保留 30 天可填 1,6,24,168,720" },
    { "type": "title", "label": "备案设置" },
    { "key": "icpEnabled", "type": "boolean", "label": "显示备案号", "default": false },
    { "key": "icpNumber", "type": "string", "label": "备案号", "default": "", "help": "如：京ICP备12345678号" },
    { "key": "icpUrl", "type": "string", "label": "备案跳转链接", "default": "https://beian.miit.gov.cn/" },
    { "key": "policeEnabled", "type": "boolean", "label": "显示公安备案", "default": false },
    { "key": "policeNumber", "type": "string", "label": "公安备案号", "default": "", "help": "如：京公网安备 11010502000000号" },
    { "key": "policeUrl", "type": "string", "label": "公安备案跳转链接", "default": "", "help": "留空则不跳转" },
    { "type": "title", "label": "自定义背景" },
    { "key": "backgroundEnabled", "type": "boolean", "label": "启用自定义背景", "default": false },
    { "key": "backgroundType", "type": "select", "label": "背景类型", "default": "image", "options": [{ "value": "image", "label": "图片" }, { "value": "video", "label": "视频" }] },
    { "key": "lightBackgroundUrl", "type": "string", "label": "亮色模式背景地址", "default": "" },
    { "key": "darkBackgroundUrl", "type": "string", "label": "暗色模式背景地址", "default": "" },
    { "key": "backgroundBlur", "type": "number", "label": "背景模糊半径", "default": 0, "min": 0, "max": 50, "help": "单位 px，0 表示不模糊" },
    { "key": "backgroundOverlay", "type": "number", "label": "背景遮罩强度", "default": 0, "min": -100, "max": 100, "help": "负数降低背景透明度，0 关闭，正数为黑色遮罩，绝对值越大越明显" }
  ]
}
